HUNTER_API_KEY=your_hunter_api_key
# Domain Search limit (1-100). Free plans usually need 10 or less.
HUNTER_LIMIT=10

ODOO_URL=http://localhost:8069
ODOO_DATABASE=your_odoo_database
ODOO_API_KEY=your_odoo_api_key

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/odoo_agent
CONFIRMATION_TOKEN_SECRET=replace-with-a-long-random-secret

# Local Chrome extension backend
EXTENSION_HTTP_PORT=8765
EXTENSION_ID=your_chrome_extension_id
EXTENSION_PAIRING_TOKEN=replace-with-a-long-random-pairing-token
HERMES_BIN=hermes

# Reuse a recent non-imported discovery for the same company (minutes)
DISCOVERY_REUSE_MINUTES=30
